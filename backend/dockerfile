# Base image
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# --- INSTALAÇÃO PYTHON ---
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# --- INSTALAÇÃO DE SISTEMA (para Node.js e DB) ---
RUN apt-get update && apt-get install -y \
    nodejs \
    npm \
    postgresql-client \
    netcat-traditional \
    build-essential \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# --- INSTALAÇÃO NODE.JS (para o Gateway e Migrador) ---
COPY package.json .
COPY package-lock.json .
RUN npm install --production
# NOVO: Instala o Prisma CLI globalmente para ser usado pelo migrator
RUN npm install -g prisma 

# ===============================================
# CRUCIAL: COPIA TODOS OS ARQUIVOS DE CÓDIGO
# Inclui os scripts Python, Node.js e a pasta 'prisma'
# ===============================================
COPY . . 

# --- GERAÇÃO E CONFIGURAÇÃO DO gRPC ---
RUN python3 -m grpc_tools.protoc \
    --proto_path=./proto \
    --python_out=./proto \
    --grpc_python_out=./proto \
    ./proto/service.proto

# Fix the import in the generated grpc file
RUN sed -i 's/import service_pb2 as/from . import service_pb2 as/' proto/service_pb2_grpc.py

# Make sure proto directory is a Python package
RUN touch proto/__init__.py

EXPOSE 5000
CMD ["python", "a_server.py"]